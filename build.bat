@echo off
setlocal EnableExtensions
cd /d "%~dp0"

REM Optional: build.bat nopause  — skip pause/explorer (used by publish_release.bat)
set "NOPAUSE=0"
if /I "%~1"=="nopause" set "NOPAUSE=1"

echo === APK Updater build ===
echo.

echo Closing running APK Updater if any...
taskkill /F /IM APKUpdater.exe >nul 2>&1
taskkill /F /FI "WINDOWTITLE eq APK Updater*" >nul 2>&1
taskkill /F /FI "WINDOWTITLE eq APKUpdater*" >nul 2>&1

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0tools\close_app.ps1" 2>nul
timeout /t 1 /nobreak >nul

if exist ".venv\Scripts\python.exe" (
  set "PY=.venv\Scripts\python.exe"
  set "PIP=.venv\Scripts\pip.exe"
) else (
  set "PY=python"
  set "PIP=pip"
)

echo Using: %PY%
"%PY%" -c "import sys; print(sys.version)"
if errorlevel 1 (
  echo ERROR: Python not found. Create .venv or install Python.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

where npm >nul 2>&1
if errorlevel 1 (
  echo ERROR: npm not found. Install Node.js to build the web UI.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

echo.
echo Building web UI...
pushd web
call npm install
if errorlevel 1 (
  echo ERROR: npm install failed.
  popd
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
call npm run build
if errorlevel 1 (
  echo ERROR: npm run build failed.
  popd
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
popd

if not exist "web\dist\index.html" (
  echo ERROR: web\dist\index.html missing after build.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
if not exist "app\db\schema.sql" (
  echo ERROR: app\db\schema.sql missing.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
if not exist "app\resources\play_alarm.dex" (
  echo ERROR: app\resources\play_alarm.dex missing. Build it via tools\play_alarm\build.ps1
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

echo.
echo Embedding schema.sql into app\db\_schema_embed.py ...
"%PY%" -c "from pathlib import Path; s=Path('app/db/schema.sql').read_text(encoding='utf-8'); Path('app/db/_schema_embed.py').write_text('# Auto-generated from schema.sql — do not edit by hand.\n# Regenerated by build.bat before PyInstaller.\nfrom __future__ import annotations\n\nSCHEMA_SQL: str = '+repr(s)+'\n', encoding='utf-8')"
if errorlevel 1 (
  echo ERROR: failed to embed schema.sql
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

echo.
echo Installing build deps...
"%PIP%" install -r requirements.txt pyinstaller
if errorlevel 1 (
  echo ERROR: pip install failed.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

echo.
echo Building with PyInstaller...
"%PY%" -m PyInstaller --noconfirm --clean APKUpdater.spec
if errorlevel 1 (
  echo.
  echo ERROR: PyInstaller build failed.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

if not exist "dist\APKUpdater\APKUpdater.exe" (
  echo ERROR: dist\APKUpdater\APKUpdater.exe missing.
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)

REM Required datas under _MEIPASS (_internal in onedir builds)
set "INTERNAL=dist\APKUpdater\_internal"
if not exist "%INTERNAL%\web\dist\index.html" (
  echo ERROR: bundled web\dist\index.html missing in %INTERNAL%
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
if not exist "%INTERNAL%\app\resources\play_alarm.dex" (
  echo ERROR: bundled play_alarm.dex missing in %INTERNAL%
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
if not exist "%INTERNAL%\app\db\schema.sql" (
  echo ERROR: bundled schema.sql missing in %INTERNAL%
  if "%NOPAUSE%"=="0" pause
  exit /b 1
)
if not exist "%INTERNAL%\certifi\cacert.pem" (
  echo WARN: certifi\cacert.pem not found under %INTERNAL% — HTTPS may fail offline/corp.
)

echo.
echo Build OK.
echo EXE: "%~dp0dist\APKUpdater\APKUpdater.exe"
if "%NOPAUSE%"=="0" (
  explorer "%~dp0dist\APKUpdater"
  pause
)
exit /b 0
